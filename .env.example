# Provider: gemini (default) or anthropic
NOSH_LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Pinned to the Gemini model that worked in live runs (gemini-3.8-flash returned 503 overload errors).
# Model names change often; current lists: https://ai.google.dev/gemini-api/docs/models
# and https://platform.claude.com/docs/en/about-claude/models/overview
NOSH_GEMINI_MODEL=gemini-3.6-flash
# Used only when NOSH_LLM_PROVIDER=anthropic (untested path); the cheapest current Claude model
NOSH_ANTHROPIC_MODEL=claude-haiku-5-5
